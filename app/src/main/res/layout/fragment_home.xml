<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_drawable">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/header_drawable"
            android:layout_marginBottom="12dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home"
                android:textSize="18sp"
                android:fontFamily="@font/f42dotsans_extrabold"
                android:textAlignment="center" />


        </LinearLayout>

        <!-- Today's Goal Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/f42dotsans_bold"
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:text="Today's Goal"/>

            <Space
                android:layout_width="110dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/button_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/settings_icon" />

        </LinearLayout>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/progress_card_background"
            android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
                
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp">
                    
                    <!-- Circular Progress Indicator -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:indicatorSize="220dp"
                        app:trackThickness="16dp"
                        app:indicatorColor="@color/primary_color"
                        app:trackColor="@color/progress_track_color"
                        app:trackCornerRadius="4dp"/>

                    <!-- Step Count Text -->
                    <TextView
                        android:id="@+id/text_step_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/f42dotsans_extrabold"
                        android:textSize="40sp"
                        android:textColor="@color/primary_color"
                        android:text="0"/>
                </FrameLayout>
                    
                <!-- Goal Percentage Text -->
            <TextView
                android:id="@+id/text_goal_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/f42dotsans_regular"
                android:textSize="16sp"
                android:textColor="@color/card_text"
                android:text="0% of goal completed"
                android:layout_marginBottom="20dp"/>
                    
                <!-- Set Goal Button -->
                <Button
                    android:id="@+id/button_set_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Set Daily Goal"
                    android:backgroundTint="@color/primary_color"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:cornerRadius="8dp"/>
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Current Activity Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/f42dotsans_bold"
                android:textSize="24sp"
                android:textColor="@color/text_color"
                android:text="Current Activity"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/f42dotsans_bold"
            android:textSize="18sp"
            android:textColor="@color/card_text"
            android:text="Status: Not Recording"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="3">
                    
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:fontFamily="@font/f42dotsans_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/card_text"
                    android:text="Time"
                    android:textSize="14sp"/>

                <TextView
                    android:fontFamily="@font/f42dotsans_extrabold"
                    android:id="@+id/text_home_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/card_text"
                    android:text="0h 0m"
                    android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:fontFamily="@font/f42dotsans_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/card_text"
                    android:text="Distance"
                    android:textSize="14sp"/>

                <TextView
                    android:fontFamily="@font/f42dotsans_extrabold"
                    android:id="@+id/text_home_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/card_text"
                    android:text="0.00 km"
                    android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:fontFamily="@font/f42dotsans_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/card_text"
                    android:text="Speed"
                    android:textSize="14sp"/>

                <TextView
                    android:fontFamily="@font/f42dotsans_extrabold"
                    android:id="@+id/text_home_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/card_text"
                    android:text="0.00 km/h"
                    android:textSize="18sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Weekly Stats Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/f42dotsans_bold"
            android:textSize="24sp"
            android:textColor="@color/text_color"
            android:text="This Week"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_regular"
                            android:textSize="16sp"
                            android:textColor="@color/card_text"
                            android:text="Activities"/>
                            
                        <TextView
                            android:id="@+id/text_activities"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_bold"
                            android:textSize="24sp"
                            android:textColor="@color/card_text"
                            android:text="0"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_regular"
                            android:textSize="16sp"
                            android:textColor="@color/card_text"
                            android:text="Time"/>
                            
                        <TextView
                            android:id="@+id/text_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_bold"
                            android:textSize="24sp"
                            android:textColor="@color/card_text"
                            android:text="0h 0m"/>
        </LinearLayout>
    </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_regular"
                            android:textSize="16sp"
                            android:textColor="@color/card_text"
                            android:text="Distance"/>
                            
                        <TextView
                            android:id="@+id/text_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_bold"
                            android:textSize="24sp"
                            android:textColor="@color/card_text"
                            android:text="0.00 km"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_regular"
                            android:textSize="16sp"
                            android:textColor="@color/card_text"
                            android:text="Avg. Pace"/>
                            
                        <TextView
                            android:id="@+id/text_pace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/f42dotsans_bold"
                            android:textSize="24sp"
                            android:textColor="@color/card_text"
                            android:text="-"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
</LinearLayout>
</ScrollView>