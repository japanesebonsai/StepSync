<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_drawable">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="20sp"
        android:background="@drawable/header_drawable"
        android:elevation="4sp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="24sp"
            android:text="Home"
            android:textSize="16sp"
            android:fontFamily="@font/f42dotsans_bold"
            android:textAlignment="center" />

    </LinearLayout>

    <TextView
        android:fontFamily="@font/f42dotsans_extrabold"
        android:layout_marginTop="50sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00 / 00"
        android:textColor="#0f0f0f"
        android:elevation="4sp"
        android:layout_gravity="center"
        android:textSize="60sp"
        android:layout_marginBottom="50sp"/>

    <TextView
        android:text="\nCalories Lost: 00/00"
        android:textColor="#0f0f0f"
        android:textSize="16sp"
        android:fontFamily="@font/f42dotsans_bold"
        android:textAlignment="center"
        android:layout_margin="10sp"
        android:layout_gravity="center"
        android:layout_width="280sp"
        android:layout_height="70sp"
        android:background="@drawable/placeholder_drawable"
        android:elevation="4sp"/>

    <TextView
        android:textColor="#0f0f0f"
        android:fontFamily="@font/f42dotsans_bold"
        android:textStyle="bold"
        android:text="\nNumber of Steps: 00/00"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_margin="10sp"
        android:layout_gravity="center"
        android:layout_width="280sp"
        android:layout_height="70sp"
        android:background="@drawable/placeholder_drawable"
        android:elevation="4sp"/>

    <TextView
        android:fontFamily="@font/f42dotsans_bold"
        android:textColor="#0f0f0f"
        android:text="\nCarbon Saved: 00/00"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_margin="10sp"
        android:layout_gravity="center"
        android:layout_width="280sp"
        android:layout_height="70sp"
        android:background="@drawable/placeholder_drawable"
        android:elevation="4sp"/>

    <Space
        android:layout_width="0sp"
        android:layout_height="0sp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#f2f2f2"
        app:menu="@menu/menu_navigation"/>

</LinearLayout>

