<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_drawable">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:padding="20sp"
        android:background="@drawable/header_drawable"
        android:layout_marginBottom="20sp"
        android:elevation="4sp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="16sp"
            android:fontFamily="@font/f42dotsans_extrabold"
            android:textAlignment="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="40dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/imageview_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/profile1_icon"
            android:layout_gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginRight="20dp">

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/button_edit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Edit Profile"
                android:layout_gravity="right"
                app:icon="@drawable/edit_icon"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/text_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="24sp"
                android:fontFamily="@font/f42dotsans_bold"/>

            <TextView
                android:id="@+id/text_created_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/f42dotsans_regular"
                android:textSize="16sp"
                android:text="Account Created"/>

        </LinearLayout>

    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4sp"
        android:layout_marginLeft="20sp"
        android:layout_marginRight="20sp"
        android:fontFamily="@font/f42dotsans_bold"
        android:textSize="24sp"
        android:text="Your Activity"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_activities"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    <Space
        android:layout_width="0sp"
        android:layout_height="0sp"
        android:layout_weight="1" />


</LinearLayout>