{
  "rules": {
    "users": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid",
        ".validate": "$username.matches(/^[A-Za-z0-9_ -]{1,16}$/)"
      }
    },
    "user_activities": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "$activity_id": {
          ".validate": "newData.hasChildren(['id', 'userId', 'timestamp', 'durationSeconds', 'distanceKm', 'avgSpeedKmh'])",
          "userId": {
            ".validate": "newData.val() === auth.uid"
          }
        }
      }
    }
  }
}
